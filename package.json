{
  "name": "cp-graduation-roadmap",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @cp/web dev",
    "dev:full": "pnpm db:up && pnpm db:setup && pnpm --parallel --filter @cp/api --filter @cp/web dev:full",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "pnpm --filter @cp/api db:setup",
    "build": "pnpm --filter @cp/web build",
    "preview": "pnpm --filter @cp/web preview",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @cp/web test:e2e",
    "test:e2e:api": "pnpm db:up && pnpm db:setup && E2E_API=1 pnpm --filter @cp/web test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "checklist": "python3 learning/python/cp52_checklist_graduation.py"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
